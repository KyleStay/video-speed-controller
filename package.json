{
  "name": "video-speed-controller",
  "version": "0.11.5",
  "description": "Speed up, slow down, advance and rewind HTML5 audio/video with shortcuts",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --browser=chrome",
    "build:firefox": "node scripts/build.mjs --browser=firefox",
    "build:safari": "node scripts/build.mjs --browser=safari",
    "build:browsers": "node scripts/build.mjs --all",
    "dev": "npm run watch",
    "watch": "node scripts/build.mjs --watch",
    "prebuild": "node scripts/clean.mjs dist",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:e2e": "npm run build && node tests/e2e/run-e2e.js",
    "test:e2e:isolated": "npm run build:release && node tests/e2e/run-isolated.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "serve": "python3 -m http.server 8000",
    "lint": "eslint 'src/**/*.js' 'tests/**/*.js'",
    "lint:fix": "eslint 'src/**/*.js' 'tests/**/*.js' --fix",
    "format": "prettier --write 'src/**/*.js' 'tests/**/*.js'",
    "build:release": "RELEASE=1 node scripts/build.mjs",
    "build:release:chrome": "RELEASE=1 node scripts/build.mjs --browser=chrome",
    "build:release:browsers": "RELEASE=1 node scripts/build.mjs --all",
    "prerelease": "npm run clean && npm test",
    "release": "npm run build:release && node scripts/package-release.js",
    "release:chrome": "npm run clean && npm run lint && npm test && npm run build:release:chrome && npm run package:chrome",
    "release:browsers": "npm run build:release:browsers && node scripts/package-release.js --all",
    "package:chrome": "node scripts/package-release.js --browser=chrome",
    "package:firefox": "node scripts/package-release.js --browser=firefox",
    "package:candidate": "node scripts/package-identity-candidate.mjs",
    "package:candidate:test": "vitest run --configLoader=native tests/unit/build/identity-candidate.test.js",
    "release:github": "node scripts/github-release.js",
    "clean": "node scripts/clean.mjs dist release",
    "prepare": "husky",
    "test:e2e:browsers": "npm run build:release:browsers && node tests/e2e/run-browser-fixtures.js all",
    "test:e2e:player-controls": "npm run build:release:browsers && node tests/e2e/run-player-controls.js",
    "test:performance": "npm run build:release:browsers && node tests/e2e/run-performance-benchmark.js",
    "build:safari:native": "node scripts/safari-native.mjs",
    "build:safari:ios": "node scripts/safari-native.mjs --platform=ios-simulator",
    "build:safari:macos": "node scripts/safari-native.mjs --platform=macos",
    "build:release:safari": "RELEASE=1 node scripts/build.mjs --browser=safari",
    "test:e2e:mobile": "npm run build:release:chrome && STAYFAST_EXTENSION_DIR=dist/chrome node tests/e2e/run-isolated.js mobile",
    "test:e2e:safari": "npm run build:release:safari && node tests/e2e/run-safari.js",
    "testflight:safari": "node scripts/safari-testflight.mjs",
    "testflight:safari:archive": "node scripts/safari-testflight.mjs archive",
    "testflight:safari:export": "node scripts/safari-testflight.mjs export",
    "testflight:safari:upload": "node scripts/safari-testflight.mjs upload",
    "test:e2e:ios-player": "npm run build:release:chrome && STAYFAST_EXTENSION_DIR=dist/chrome node tests/e2e/run-isolated.js ios-player",
    "test:e2e:startup": "npm run build:release && node tests/e2e/run-startup-order.js",
    "test:e2e:resume": "npm run build:release && node tests/e2e/run-isolated.js resume"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "archiver": "^8.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "fs-extra": "^11.4.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "puppeteer": "^25.14.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "semi": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 100
  }
}
